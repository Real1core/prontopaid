# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public address of the app, used in links sent to customers and back from Stripe,
# e.g. https://app.prontopaid.com. Blank: the address the app was opened at.
BASE_URL=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Blank: one is made and kept in DATA_DIR.
SESSION_SECRET=
# Where the database, logos and landing page photos are stored. Back this folder up.
DATA_DIR=./data
# Time zone for quote and invoice dates.
APP_TIMEZONE=America/Los_Angeles

# ---- Email (optional) ----------------------------------------------------------------------
# Without it, quotes and invoices are sent by copying the link or downloading the PDF, and
# notices only show on the bell in the app.
# Microsoft 365: smtp.office365.com, port 587. Google Workspace: smtp.gmail.com, 587, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The address emails come from. Replies go to whoever sent the quote or invoice.
MAIL_FROM=

# ---- Stripe: getting paid, connecting banks, Premium (see README > Stripe) -------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint for events on ProntoPaid's own account.
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook endpoint (events on businesses' accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=
# The monthly Premium price, e.g. price_1Abc…
STRIPE_PREMIUM_PRICE_ID=
# ProntoPaid's share of each online payment, in percent. 0 = none.
PLATFORM_FEE_PERCENT=0

# ---- Customer financing (see README > Financing) --------------------------------------------
# "wisetack" once ProntoPaid is a Wisetack partner; "test" for a pretend lender; blank = off.
FINANCING_PROVIDER=
WISETACK_API_URL=https://api.wisetack.com
WISETACK_API_KEY=
WISETACK_WEBHOOK_SECRET=
# Where a business enrolls as a Wisetack merchant through ProntoPaid (from Wisetack).
WISETACK_SIGNUP_URL=
# The amounts customers can finance, in dollars.
FINANCING_MIN=500
FINANCING_MAX=25000

# Local testing only: every business gets Premium without a subscription.
PREMIUM_FOR_ALL=false
