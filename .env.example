# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public address of the app, used in the links customers get, e.g. https://quotes.yourcompany.com
# Blank: the address the app was opened at.
BASE_URL=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Blank: one is made and kept in DATA_DIR.
SESSION_SECRET=
# Where the database and logo are stored. Back this folder up.
DATA_DIR=./data
# Time zone for quote and invoice dates.
APP_TIMEZONE=America/Los_Angeles

# Email (optional). Without it, send quotes and invoices by copying the link or downloading the PDF.
# Microsoft 365: smtp.office365.com, port 587, your mailbox and password (SMTP AUTH must be on for it).
# Google Workspace: smtp.gmail.com, port 587, your address and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The address emails come from (usually the same as SMTP_USER). Replies go to whoever sent it.
MAIL_FROM=
